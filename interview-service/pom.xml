<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      面试官服务 (D15 机械拆分)。

      依赖版本全部由 mockverse-parent 集中声明 (properties 继承), 与单体逐字一致——
      版本锁定纪律: 禁止中途变更依赖版本。

      裁剪口径: 只保留面试主流程链路 (root_coordinator + interviewer_agent),
      不含 pgvector / 本地 ONNX embedding / 简历诊断 (归属另两个服务)。
    -->
    <parent>
        <groupId>com.mockverse</groupId>
        <artifactId>mockverse-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>interview-service</artifactId>
    <name>MockVerse Interview Service</name>
    <description>面试主流程服务: start / answer(同步+SSE) / history / health, 8081</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          D20: 异步判题的生产端 + 结果消费端。版本由 spring-boot-starter-parent 3.3.1 的 BOM
          决定（版本锁定纪律：不手填版本号）。
          注意这是**新增一条链路**，不是替换：D18 的 MCP 同步判题（judge_code）继续保留，
          两条路径共用 judge-service 的同一个 JavaJudge。
        -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!--
          D23: Redis。题库候选集缓存 / 会话级分布式锁 / SSE 限流三项能力都基于它。
          版本由 spring-boot-starter-parent 3.3.1 的 BOM 决定（版本锁定纪律：不手填版本号）。
          默认客户端是 Lettuce（Netty 异步），无需额外依赖。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ADK Agent 编排 + LangChain4j 桥接 (DeepSeek 走 [OI] 兼容协议) -->
        <dependency>
            <groupId>com.google.adk</groupId>
            <artifactId>google-adk</artifactId>
            <version>${adk.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.adk</groupId>
            <artifactId>google-adk-langchain4j</artifactId>
            <version>${adk.version}</version>
        </dependency>
        <!--
          D16: A2A 服务端。google-adk-a2a 提供 com.google.adk.a2a.executor.AgentExecutor
          (把 ADK Runner 适配成 a2a SDK 的 AgentExecutor); 传输层与 JSON-RPC 处理器
          在 a2a-java-sdk-server-common 里。两者版本必须配套, 见父 POM 的 a2a-sdk.version 注释。
        -->
        <dependency>
            <groupId>com.google.adk</groupId>
            <artifactId>google-adk-a2a</artifactId>
            <version>${adk.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.a2asdk</groupId>
            <artifactId>a2a-java-sdk-server-common</artifactId>
            <version>${a2a-sdk.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.a2asdk</groupId>
            <artifactId>a2a-java-sdk-spec</artifactId>
            <version>${a2a-sdk.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>

        <!--
          D23: Nacos 客户端（服务注册 + 动态配置）。
          刻意**不用** spring-cloud-starter-alibaba-nacos-discovery：本项目没有 Spring Cloud 生态
          （无 OpenFeign/Gateway/LoadBalancer），SCA 会把整套 Spring Cloud 上下文带进来，
          而它提供的只是对同一个 nacos-client 的封装。取舍见 NacosProperties 类注释。
        -->
        <dependency>
            <groupId>com.alibaba.nacos</groupId>
            <artifactId>nacos-client</artifactId>
            <version>${nacos-client.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
