# docker compose 用的环境变量模板（D24）
#
# 复制到**仓库根**并改名 .env（该文件被 .gitignore 的 *.env 排除，不会入库）：
#     cp docker/.env.example .env
# 然后按本机实际填值。
#
# 注意：宿主机模式（java -jar 起服务）读的是仓库根的 dev.env，
# 两份文件在 MySQL/PG 凭据上必须一致——容器和宿主机连的是同一套库。

# ---- 基础设施凭据（compose 顶层变量替换从这里读）----
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=mockverse
PG_PASSWORD=change-me
PG_DATABASE=mockverse
PG_USER=mockverse

# ---- 模型 ----
DEEPSEEK_API_KEY=sk-xxxxxxxx
# 可选：走代理/兼容端点时填
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- 服务端口（一般不用改）----
# NGINX_PORT=80
