<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      MockVerse 多模块父 POM (D15 拆分决策)。

      三个子模块 (interview/knowledge/resume-service) 的依赖版本全部集中在这里声明,
      与 mockverse-monolith 的版本锁定表逐字一致 —— 版本锁定纪律: 禁止中途变更依赖版本,
      父 POM 只做集中管理, 不做升级。

      D21 起 mockverse-monolith 已退役（目录删除）: 基线保留在 tag v0.1-monolith,
      需要时 git checkout v0.1-monolith 取回，只读参考。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.1</version>
        <relativePath/>
    </parent>

    <groupId>com.mockverse</groupId>
    <artifactId>mockverse-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>MockVerse Parent</name>
    <description>MockVerse 微服务拆分父 POM: 三服务 + 统一依赖版本</description>

    <modules>
        <module>interview-service</module>
        <module>knowledge-service</module>
        <module>resume-service</module>
        <module>judge-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 与 Spring Boot 3.3.x 配套的 MyBatis-Plus 线; 与单体逐字一致, 不升级 -->
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <!-- D3 起锁定的 ADK 线, 与 adk-java 源码克隆 1.13.0 一致 -->
        <adk.version>1.13.0</adk.version>
        <langchain4j.version>1.12.2</langchain4j.version>
        <!-- D10: 本地 ONNX embedding 模块走 beta 线, 与 core 1.12.2 对齐 -->
        <langchain4j.embeddings.version>1.12.2-beta22</langchain4j.embeddings.version>
        <!--
          D16: ADK 的 A2A 集成层 (google-adk-a2a) 依赖官方 a2a-java SDK 0.3.2.Final。
          版本取自 adk-java 1.13.0 的 a2a/pom.xml (a2a.sdk.version), 不是我们挑的 ——
          换成 1.x 线会与 ADK 的 io.a2a.* 包名不兼容 (见 docs/a2a-comparison-d6.md)。
        -->
        <a2a-sdk.version>0.3.2.Final</a2a-sdk.version>
        <!--
          D18: judge-service 的 MCP 服务端。2.0.0 不是新挑的版本——google-adk 1.13.0 的
          McpToolset 已经传递依赖 io.modelcontextprotocol.sdk:mcp:2.0.0（D18 开工时
          `mvn dependency:tree -Dincludes=io.modelcontextprotocol.sdk` 实证）。
          这里只是把"客户端已经在用的那条线"显式钉住，让服务端与客户端同版本。
        -->
        <mcp-sdk.version>2.0.0</mcp-sdk.version>
        <!--
          D18: MCP SDK 2.0.0 的 mcp-core 编译期依赖 jackson-annotations 2.20
          （它引用了 Jackson 2.20 才有的 JsonFormat.Shape.POJO）。Spring Boot 3.3.1 的
          jackson-bom 把 annotations 压到 2.17.1，运行期直接
          NoSuchFieldError: JsonFormat$Shape does not have member field POJO —— D18 实测。
          只抬 annotations 不抬 databind：annotations 是纯注解、向后兼容，databind 仍留在
          Spring Boot 认证过的 2.17.1，把改动面压到最小。
        -->
        <jackson-annotations.version>2.20</jackson-annotations.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 覆盖 spring-boot-dependencies 里 jackson-bom 的传递版本，见上方注释 -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-annotations</artifactId>
                <version>${jackson-annotations.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
