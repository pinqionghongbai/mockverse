From 1c1c33b7dd585915f236f29f292124ec6ff0a9cd Mon Sep 17 00:00:00 2001
From: hongbailingmeng <3471972616@qq.com>
Date: Wed, 28 Oct 2026 11:42:45 +0800
Subject: [PATCH] fix(a2a): read the A2A ids from the keys that are actually
 written

ResponseConverter stores the task and context ids in an event's custom
metadata under AdkMetadataKey, which prefixes them with "a2a:". EventConverter
read them back under "adk_task_id" and "adk_context_id", keys nothing writes,
so taskId(event) and contextId(event) returned an empty string for every event
the A2A converters produced.

RemoteA2AAgent relies on both accessors when it builds a follow-up message for
a function response, so the task and context ids were silently dropped from
the outgoing request.

The constants now carry the keys ResponseConverter writes. EventConverterTest
asserts they match AdkMetadataKey, so the two cannot drift apart again -- the
existing round-trip tests could not catch this, because they build the event
with the same constant they read it back with.

Covered by ContextIdRoundTripTest, which asserts the ids survive
ResponseConverter -> EventConverter.
---
 .../adk/a2a/converters/EventConverter.java    |  11 +-
 .../converters/ContextIdRoundTripTest.java    | 111 ++++++++++++++++++
 .../a2a/converters/EventConverterTest.java    |  11 ++
 3 files changed, 131 insertions(+), 2 deletions(-)
 create mode 100644 a2a/src/test/java/com/google/adk/a2a/converters/ContextIdRoundTripTest.java

diff --git a/a2a/src/main/java/com/google/adk/a2a/converters/EventConverter.java b/a2a/src/main/java/com/google/adk/a2a/converters/EventConverter.java
index df10a9c..d4841b7 100644
--- a/a2a/src/main/java/com/google/adk/a2a/converters/EventConverter.java
+++ b/a2a/src/main/java/com/google/adk/a2a/converters/EventConverter.java
@@ -31,8 +31,15 @@ import org.jspecify.annotations.Nullable;
 
 /** Converter for ADK Events to A2A Messages. */
 public final class EventConverter {
-  public static final String ADK_TASK_ID_KEY = "adk_task_id";
-  public static final String ADK_CONTEXT_ID_KEY = "adk_context_id";
+  /**
+   * Keys the A2A ids are stored under in an event's custom metadata.
+   *
+   * <p>They have to match {@link AdkMetadataKey}, which is what {@link ResponseConverter} uses when
+   * it writes those ids into an event. {@code EventConverterTest} keeps the two in step.
+   */
+  public static final String ADK_TASK_ID_KEY = "a2a:task_id";
+
+  public static final String ADK_CONTEXT_ID_KEY = "a2a:context_id";
 
   private EventConverter() {}
 
diff --git a/a2a/src/test/java/com/google/adk/a2a/converters/ContextIdRoundTripTest.java b/a2a/src/test/java/com/google/adk/a2a/converters/ContextIdRoundTripTest.java
new file mode 100644
index 0000000..fff1ae1
--- /dev/null
+++ b/a2a/src/test/java/com/google/adk/a2a/converters/ContextIdRoundTripTest.java
@@ -0,0 +1,111 @@
