+package com.google.adk.a2a.converters;
+
+import static com.google.common.truth.Truth.assertThat;
+
+import com.google.adk.agents.InvocationContext;
+import com.google.adk.agents.RunConfig;
+import com.google.adk.artifacts.InMemoryArtifactService;
+import com.google.adk.events.Event;
+import com.google.adk.plugins.PluginManager;
+import com.google.adk.sessions.InMemorySessionService;
+import com.google.adk.sessions.Session;
+import com.google.common.collect.ImmutableList;
+import io.a2a.spec.Message;
+import io.a2a.spec.Task;
+import io.a2a.spec.TaskState;
+import io.a2a.spec.TaskStatus;
+import io.a2a.spec.TextPart;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.junit.runners.JUnit4;
+
+/**
+ * Verifies that a context id survives the A2A-to-ADK conversion.
+ *
+ * <p>{@link RemoteA2AAgent} reads the context id back out of the converted event with {@link
+ * EventConverter#contextId}, so the two converters have to agree on the metadata key.
+ */
+@RunWith(JUnit4.class)
+public final class ContextIdRoundTripTest {
+
+  private InvocationContext invocationContext;
+
+  @Before
+  public void setUp() {
+    Session session =
+        Session.builder("session-1")
+            .appName("demo")
+            .userId("user")
+            .events(ImmutableList.of())
+            .build();
+    invocationContext =
+        InvocationContext.builder()
+            .sessionService(new InMemorySessionService())
+            .artifactService(new InMemoryArtifactService())
+            .pluginManager(new PluginManager())
+            .invocationId("invocation-1")
+            .agent(new TestAgent())
+            .session(session)
+            .runConfig(RunConfig.builder().build())
+            .endInvocation(false)
+            .build();
+  }
+
+  @Test
+  public void taskToEvent_thenContextId_returnsThePeerContextId() {
+    Task task =
+        new Task.Builder()
+            .id("task-1")
+            .contextId("context-1")
+            .status(
+                new TaskStatus(
+                    TaskState.COMPLETED,
+                    new Message.Builder()
+                        .role(Message.Role.AGENT)
+                        .parts(ImmutableList.of(new TextPart("done")))
+                        .build(),
+                    null))
+            .build();
+
+    Event event = ResponseConverter.taskToEvent(task, invocationContext);
+
+    assertThat(event.customMetadata().get()).isNotEmpty();
+    assertThat(EventConverter.contextId(event)).isEqualTo("context-1");
+    assertThat(EventConverter.taskId(event)).isEqualTo("task-1");
+  }
+
+  private static final class TestAgent extends com.google.adk.agents.BaseAgent {
+    TestAgent() {
+      super("test_agent", "test", ImmutableList.of(), null, null);
+    }
+
+    @Override
+    protected io.reactivex.rxjava3.core.Flowable<Event> runAsyncImpl(
+        InvocationContext invocationContext) {
+      return io.reactivex.rxjava3.core.Flowable.empty();
+    }
+
+    @Override
+    protected io.reactivex.rxjava3.core.Flowable<Event> runLiveImpl(
+        InvocationContext invocationContext) {
+      return io.reactivex.rxjava3.core.Flowable.empty();
+    }
+  }
+}
diff --git a/a2a/src/test/java/com/google/adk/a2a/converters/EventConverterTest.java b/a2a/src/test/java/com/google/adk/a2a/converters/EventConverterTest.java
index 51fc318..11584c4 100644
--- a/a2a/src/test/java/com/google/adk/a2a/converters/EventConverterTest.java
+++ b/a2a/src/test/java/com/google/adk/a2a/converters/EventConverterTest.java
@@ -79,6 +79,17 @@ public final class EventConverterTest {
     assertThat(EventConverter.contextId(e)).isEmpty();
   }
 
+  /**
+   * The accessors read the keys that {@link ResponseConverter} writes through {@link
+   * AdkMetadataKey}, so the two have to agree. Reading a different key returns an empty string,
+   * which is indistinguishable from "the event has no id".
+   */
+  @Test
+  public void idKeys_matchTheKeysResponseConverterWrites() {
+    assertThat(EventConverter.ADK_TASK_ID_KEY).isEqualTo(AdkMetadataKey.TASK_ID.getType());
+    assertThat(EventConverter.ADK_CONTEXT_ID_KEY).isEqualTo(AdkMetadataKey.CONTEXT_ID.getType());
+  }
+
   @Test
   public void testFindUserFunctionCall_success() {
     Event agentEvent = Event.builder().author("agent").build();
